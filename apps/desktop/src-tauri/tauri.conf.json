{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "docgait",
  "identifier": "com.dallinjones.docgait",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "docgait", "width": 1280, "height": 860, "minWidth": 900, "minHeight": 600 }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Merge, de-duplicate, browse and search your files",
    "macOS": { "signingIdentity": "-" },
    "linux": {
      "deb": { "depends": [] }
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
